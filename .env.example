# BuecherFreunde Konfiguration

# Server
HOST=0.0.0.0
PORT=8000
EXTERNAL_PORT=8160

# Anmeldung mit dem Konto der Kellerwolke (App-Zugang in zugang/kellerwolke.schluessel, Modus 0600)
KELLERWOLKE_URL=https://192.168.1.20:39280
KELLERWOLKE_CA=/app/zugang/hausstelle.pem
KELLERWOLKE_SCHLUESSEL_DATEI=/app/zugang/kellerwolke.schluessel
ANMELDUNG_KONTEN=
# Apps, die den Bestand über den Anbieterweg fundus/* lesen dürfen
FUNDUS_APPS=Fundus

# Pfade
STORAGE_DIR=./storage
EXTERNAL_DIR=./external
IMPORT_DIR=./import
DATABASE_DIR=./database

# Open Library API
OPENLIBRARY_ENABLED=true
OPENLIBRARY_RATE_LIMIT=1

# LM Studio (KI-Kategorisierung)
LM_STUDIO_ENABLED=false
LM_STUDIO_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=qwen2.5

# Logging
LOG_LEVEL=info
