# BuecherFreunde Konfiguration

# Server
HOST=0.0.0.0
PORT=8000
EXTERNAL_PORT=8160
# erreichbar im ganzen Heimnetz; 127.0.0.1, wenn ein Vorbau mit HTTPS davorsteht
BINDUNG=0.0.0.0

# --- Anschlüsse, alle freiwillig. Was leer bleibt, fehlt einfach; die App läuft vollständig ohne. ---

# Kellerwolke: leer = eigenes Konto (beim ersten Öffnen anlegen) und Bücher auf diesem Gerät.
# Mit Adresse: Anmeldung mit deren Konto und Bücher dort (App-Zugang in zugang/kellerwolke.schluessel, Modus 0600)
KELLERWOLKE_URL=
KELLERWOLKE_CA=
KELLERWOLKE_SCHLUESSEL_DATEI=
ANMELDUNG_KONTEN=
# Suche nach Bedeutung (Fundus), Assistent, Nachschlagen
FUNDUS_URL=
ASSISTENT_URL=
NACHSCHLAG_URL=
# Apps, die den Bestand über den Anbieterweg fundus/* lesen dürfen
FUNDUS_APPS=Fundus
# Codestellen ausführen und aufzeichnen in der Sandbox der Codeschmiede (mit dem App-Zugang der Kellerwolke);
# leer: keine Taste, erkannt werden Codestellen trotzdem
CODESCHMIEDE_URL=
CODESTELLEN_JE_RUNDE=3
VORPRUEFUNG_ABSTAND_S=5
# Texterkennung eingescannter Bücher (BF-109, docs/neubau/TEXTERKENNUNG.md): das Programm liegt im Abbild; fehlt es, bleiben
# Scans Bilder. Sprachdaten mit + verbunden, Rechenkerne je Seite
TEXTERKENNUNG_SPRACHEN=deu+eng
TEXTERKENNUNG_KERNE=1
# KI über die Leitstelle (docs/LEITSTELLE.md) zum Einordnen und für die Vorprüfung der Codestellen: Schlüssel als
# Datei, Modus 0600, etwa zugang/leitstelle.schluessel; leer: ohne KI, eingeordnet wird von Hand
LEITSTELLE_ADRESSE=
LEITSTELLE_SCHLUESSEL_DATEI=
KI_MODELL=qwen/qwen3-next-80b
# Vorlesen und feste Ansagen über die Vertonung (Stimmen privat, fremd, eingebaut; BF-14), mit dem App-Zugang der Kellerwolke;
# leer: die Stimmen des Geräts
VERTONUNG_URL=

# Pfade
STORAGE_DIR=./storage
EXTERNAL_DIR=./external
IMPORT_DIR=./import
DATABASE_DIR=./database
# Eingangsordner auf dem Gerät (nur ohne Kellerwolke): was hier abgelegt wird, kommt von selbst in die Bibliothek
EINGANGSORDNER_DIR=./eingangsordner

# Quellen für Angaben zu Büchern und Autoren, alle ohne Schlüssel und einzeln abschaltbar
DNB_ENABLED=true
K10PLUS_ENABLED=true
OPENLIBRARY_ENABLED=true
OPENLIBRARY_RATE_LIMIT=1
CROSSREF_ENABLED=true
WIKIPEDIA_ENABLED=true
GND_ENABLED=true
GUTENBERG_ENABLED=true
# Gemeinfreie Bücher: der eigene Katalog kommt vom Spiegel des Project Gutenberg (Pfad dort) und wird erneuert, wenn er älter
# als so viele Tage ist; "Bei Gutendex suchen" wartet so viele Sekunden auf den oft langsamen Suchdienst
GUTENBERG_KATALOG_PFAD=/cache/epub/feeds/pg_catalog.csv.gz
GUTENBERG_KATALOG_TAGE=7
GUTENBERG_SUCHE_GEDULD_S=120
# Google Books antwortet nur mit eigenem Schlüssel; leer: wird nie gefragt
GOOGLE_BOOKS_ENABLED=true
GOOGLE_BOOKS_API_KEY=
# Freiwillig: Adresse einer Seite oder Mail, die im Ausweis der App mitgeht; Wikimedia und Open Library erlauben damit mehr
QUELLEN_KONTAKT=
# Höchstens so viele Anfragen je Quelle und Tag in Hintergrundläufen (Ergänzen, Autorenabgleich, Aufnahme)
QUELLEN_HINTERGRUND_TAG=500
QUELLEN_VORRAT_MB=32
# Suche im Buch: so lange (Sekunden) darf ein regulärer Ausdruck suchen, dann wird er beendet
SUCHE_AUSDRUCK_S=5

# Ersteinrichtung (docs/neubau/EINRICHTUNG.md). Schlüssel, die in der App eingetragen werden, liegen in dieser Datei (Modus 0600)
# und gelten vor den Dateien oben; leer: schluessel.json beim Bestand
SCHLUESSEL_DATEI=
# Vorgaben, solange in den Einstellungen nichts gewählt ist: Sicherungen auch in der Kellerwolke, Persönliches je Buch als
# kleiner Begleiter in der Kellerwolke
SICHERUNG_IN_KELLERWOLKE=true
PERSOENLICH_IN_KELLERWOLKE=true
# vor dem ersten Konto: so viele Anfragen an Adressen (Verbindung prüfen, Umzug) je Minute
EINRICHTUNG_PRUEFUNGEN_JE_MINUTE=6
# Umzug mit Einmalcode: Gültigkeit des Codes (Minuten), falsche Versuche, Dauer der Sitzung zum Holen der Originale (Stunden)
UMZUG_CODE_GILT_MIN=15
UMZUG_VERSUCHE=5
UMZUG_SITZUNG_STUNDEN=72

# Logging
LOG_LEVEL=info
